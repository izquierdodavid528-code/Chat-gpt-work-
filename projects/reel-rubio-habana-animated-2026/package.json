    "render:pilot:validation": "remotion render src/index.ts AdvancedOpeningPilot out/rubio-habana-advanced-opening-pilot-v4-validation.mp4 --frames=0-539 --codec=h264 --pixel-format=yuv420p --crf=18 --log=info"
  },
  "dependencies": {
